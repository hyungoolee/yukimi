# Copy to .env and fill in. Never commit .env.

# Where resident and call JSON files live. On the host, the mounted disk.
DATA_DIR=.data
# Public URL of this app, used in LINE links and by the agent's emergency tool.
APP_URL=
# Any long random string. Guards the call trigger and the emergency tool.
APP_SECRET=
# If set, the dashboard asks for this password (any user name).
DASHBOARD_PASSWORD=
# 1 = the missed-call ladder runs in under a minute and calls are short demo calls with a lighter health check. Never for real residents.
DEMO_MODE=
# saved = use data/seed/weather.json instead of live JMA data.
WEATHER_SOURCE=

# ElevenLabs. Create the post-call webhook in the ElevenLabs dashboard, pointing at
# APP_URL/api/webhooks/elevenlabs, then run agent/setup.ts to get the tool and agent IDs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TOOL_ID=
ELEVENLABS_AGENT_ID=
# The news agent (agent/news.md): phones a resident once someone says when they will come. Printed by pnpm agent:setup.
ELEVENLABS_NEWS_AGENT_ID=

# Extraction
ANTHROPIC_API_KEY=

# LINE Messaging API. Webhook URL: APP_URL/api/webhooks/line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Set to 1 to phone every active resident at their call time each day. Off by default: these calls
# cost money and ring real phones.
DAILY_CALLS=
# How many calls may be in progress at once (your ElevenLabs/Twilio plan's limit). Default 5.
MAX_CONCURRENT_CALLS=
