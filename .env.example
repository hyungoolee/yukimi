# Copy to .env and fill in. Never commit .env.

# Where resident and call JSON files live. On the host, the mounted disk.
DATA_DIR=.data

# M1: calls
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# M2: extraction
ANTHROPIC_API_KEY=

# M3: alerts
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# M8: traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
